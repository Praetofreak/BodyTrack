<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup (API <= 30). Backs up the Room database and DataStore preferences
   when the user has device backup enabled in the system settings — the backup
   itself is opt-in at OS level, the app never forces it.
-->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="file" path="datastore/" />
</full-backup-content>
