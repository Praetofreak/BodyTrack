<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for API 31+. Cloud backup only runs when the user has enabled
   device backup in the system settings; device-transfer covers direct
   device-to-device migration.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
